<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BackGroudColor"
    tools:context=".secondFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/RegisterLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ImgView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/logo"
                android:background="@drawable/btn_round_logo"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <TextView
                android:id="@+id/TView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App Context"
                android:textSize="30dp"
                android:textColor="@color/white"
                android:layout_marginTop="10dp"
                android:textAlignment="center"
                tools:ignore="MissingConstraints"
                app:layout_constraintTop_toBottomOf="@+id/ImgView"/>
            <TextView
                android:id="@+id/TView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textSize="40dp"
                android:textColor="@color/white"
                android:layout_marginTop="20dp"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@+id/TView"

                />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/TInput_Email"
                android:layout_marginTop="20dp"
                app:startIconDrawable="@drawable/round_account_circle_24"
                app:startIconTint="@color/PrimaryColor"
                app:layout_constraintTop_toBottomOf="@+id/TView1"
                android:paddingHorizontal="20dp"

                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/TEdit_Email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:hint="Email"

                    />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/TInput_Username"
                app:startIconDrawable="@drawable/username_24"
                app:startIconTint="@color/PrimaryColor"
                app:layout_constraintTop_toBottomOf="@+id/TInput_Email"
                android:paddingHorizontal="20dp"

                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/TEdit_Username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:hint="Username"

                    />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TInput_Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                app:startIconDrawable="@drawable/password_24"
                app:endIconDrawable="@drawable/password_toggle"
                app:endIconMode="password_toggle"
                app:layout_constraintTop_toBottomOf="@+id/TInput_Username">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/TEdit_Password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:hint="Password:"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:ellipsize="end"

                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TInput_CfPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                app:startIconDrawable="@drawable/confirm_password"
                app:endIconDrawable="@drawable/password_toggle"
                app:endIconMode="password_toggle"
                app:layout_constraintTop_toBottomOf="@+id/TInput_Password">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/TEdit_CfPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:hint="Confirm Password:"
                    android:inputType="textPassword"


                    android:maxLines="1"
                    android:ellipsize="end"

                    />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/BLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Register"
                android:textSize="30dp"
                android:layout_margin="20dp"
                app:layout_constraintTop_toBottomOf="@+id/TInput_CfPassword"
                android:background="@drawable/btn_round_20"
                app:backgroundTint="@null"
                android:enabled="false"
                />
            <TextView
                android:id="@+id/Forgot_Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:textAlignment="center"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/BLogin"
                android:clickable="true"
                android:focusable="true"
                />
            <LinearLayout
                android:id="@+id/LLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@+id/Forgot_Password">
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Or login with"
                    android:textSize="20sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:textColor="@color/white"
                    />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/IImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/LLogin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                >
                <ImageButton
                    android:id="@+id/IBFacebook"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/facebook"
                    android:background="@drawable/btn_round"
                    android:padding="12dp"
                    android:scaleType="centerInside"

                    android:contentDescription="sign up with facebook"

                    />
                <ImageButton
                    android:id="@+id/IBGoogle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/google"
                    android:background="@drawable/btn_round"
                    android:padding="12dp"
                    android:scaleType="centerInside"

                    />
                <ImageButton
                    android:id="@+id/IBGithub"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/github"
                    android:background="@drawable/btn_round"
                    android:padding="12dp"
                    android:scaleType="centerInside"

                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/IImage">
                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account?"
                    android:textSize="20sp"
                    android:textAlignment="center"
                    android:textColor="@color/white"

                    />
                <TextView
                    android:id="@+id/tvLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Login"
                    android:textSize="20sp"
                    android:textColor="@color/PrimaryColor"
                    android:paddingStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    />
            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>